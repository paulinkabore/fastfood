# --- Développement : copiez ce fichier en .env et remplissez les valeurs ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/nom_base?schema=public"
JWT_ACCESS_SECRET=remplacer_par_un_secret_de_48_octets_minimum

# Paiement : none = espèces seulement ; mock = simulation (développement uniquement)
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# --- Production : à saisir dans le tableau de bord de l'hébergeur, jamais dans ce fichier ---
# NODE_ENV=production
# PUBLIC_APP_URL=https://votre-domaine
# CORS_ORIGIN=https://votre-domaine
# SERVE_FRONTEND=true
# TRUST_PROXY=1
# UPLOAD_DIR=/data/uploads
# --- Vercel : à saisir dans Project Settings > Environment Variables (jamais dans ce fichier) ---
# DATABASE_URL=adresse de la base (utiliser l'adresse « pooled » du fournisseur)
# JWT_ACCESS_SECRET=secret de 48 caractères minimum
# PAYMENT_PROVIDER=none
# TRUST_PROXY=1
# PUBLIC_APP_URL et CORS_ORIGIN : déduits automatiquement de l'adresse Vercel si absents
# Frontend uniquement :
# VITE_REALTIME=false
